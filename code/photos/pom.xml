  <project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.donohoedigital</groupId>
    <artifactId>all</artifactId>
    <version>1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>photos</artifactId>
  <packaging>jar</packaging>
  <name>photos</name>

  <dependencies>
    <dependency>
      <groupId>com.donohoedigital</groupId>
      <artifactId>engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.donohoedigital.ddphotos.PhotosMain</mainClass>
            </manifest>
            <manifestEntries>
              <!-- Dependencies (log4j-api, flatlaf) ship META-INF/versions/9 classes.
                   Without this, the merged jar silently falls back to their Java 8
                   versions - log4j's StackLocator then can't find the calling class. -->
              <Multi-Release>true</Multi-Release>
            </manifestEntries>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
      </plugin>

      <!-- Run the app with 'mvn exec:exec' - the same JVM options the ddphotos-app
           script uses, but without needing bash (see README-DEV.md). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <arguments>
            <argument>-Dfile.encoding=UTF-8</argument>
            <argument>-Dsun.java2d.noddraw=true</argument>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Xms32m</argument>
            <argument>-Xmx256m</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>com.donohoedigital.ddphotos.PhotosMain</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
